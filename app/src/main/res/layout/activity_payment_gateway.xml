<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaymentGatewayActivity"
    android:padding="16dp"
    android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Gateway"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="left"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fsdcsdcdscdsed"
                android:textColor="@color/error_red"
                android:textSize="18sp"
                android:layout_alignParentEnd="true"
                android:id="@+id/payableAmount"/>
        </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".PaymentGatewayActivity"
        android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- UPI Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/upiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"

            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/upiTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay via UPI"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/upiOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/googlepay"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/googlePay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Google Pay"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/phonepe"
                            android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/phonePe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PhonePe"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/paytm"
                            android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/paytm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Paytm"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Cards Payment Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"

            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/cardsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay via Card"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/cardDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <EditText
                        android:id="@+id/cardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Card Number"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/cardExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="MM/YY"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/cardCVV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="CVV"
                        android:inputType="numberPassword" />

                    <Button
                        android:id="@+id/payButtonCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pay"
                        android:layout_gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Wallets Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/walletsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"

            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/walletsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay via Wallet"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/walletOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/paytm"
                            android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/walletOption1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Paytm Wallet"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/amazonpay"
                            android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/walletOption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Amazon Pay"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
</LinearLayout>
