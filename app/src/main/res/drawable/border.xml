<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Inner color, change as needed -->
            <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
            <corners android:radius="12dp"/> <!-- Radius for rounded corners -->
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#3498DB"/> <!-- Outer border color -->
            <corners android:radius="12dp"/> <!-- Radius for rounded corners -->
        </shape>
    </item>
</layer-list>
